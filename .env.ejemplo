# Copia este archivo como ".env" (con el punto) y rellena tus valores reales.
# Súbelo, si puedes, a la carpeta HOME de cPanel (un nivel ARRIBA de public_html),
# no dentro de la carpeta pública de la app. config.php ya busca ahí primero.
#
# Genera una API Key NUEVA en https://aistudio.google.com/apikey (revoca la vieja
# después de crear esta) y una contraseña de app distinta a la que estaba expuesta.

APP_PASSWORD=pon-aqui-una-clave-larga-y-nueva
GEMINI_API_KEY=pon-aqui-tu-api-key-nueva
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-3-flash-preview
